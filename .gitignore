# =========================
# GLOBAL IGNORES
# =========================
*.class
*.log
*.swp
.DS_Store
.history
.vscode/
.idea/

# Environments & Secrets
.env
.env.local
.venv
env/
venv/
ENV/
*.pem

# =========================
# BACKEND (PYTHON / FASTAPI)
# =========================
backend/__pycache__/
backend/*.py[codz]
backend/*$py.class
backend/*.so
backend/.Python
backend/dist/
backend/build/
backend/*.egg-info/
backend/.pytest_cache/

# =========================
# FRONTEND (FLUTTER / DART)
# =========================
